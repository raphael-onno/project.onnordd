<Application x:Class="MediaspotIngest.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MediaspotIngest.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF's Fluent dark theme, then Mediaspot's palette on top (later dictionaries win). -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
                <ResourceDictionary Source="Theme/Mediaspot.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusBrushConverter x:Key="StatusBrush" />
            <conv:StatusFillConverter x:Key="StatusFill" />
            <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
