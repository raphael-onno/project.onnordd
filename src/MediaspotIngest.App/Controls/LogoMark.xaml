<UserControl x:Class="MediaspotIngest.App.Controls.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- onnoRDD mark on a 24-unit grid (same geometry as tools/make-icon.ps1): a tape reel going to Mediaspot. -->
    <Viewbox>
        <Canvas Width="24" Height="24">
            <Rectangle Width="24" Height="24" RadiusX="3" RadiusY="3" Fill="#2D6CE1" />
            <Polygon Points="8.2,9.2 14.6,4.6 18.4,4.6 12,9.2" Fill="#E6FFFFFF" />
            <Ellipse Canvas.Left="3.2" Canvas.Top="9" Width="10.6" Height="10.6" Fill="White" />
            <Ellipse Canvas.Left="6.9" Canvas.Top="12.7" Width="3.2" Height="3.2" Fill="#2D6CE1" />
            <Ellipse Canvas.Left="16.4" Canvas.Top="13.4" Width="4.4" Height="4.4" Fill="#F7C035" />
        </Canvas>
    </Viewbox>
</UserControl>
