<Window x:Class="MediaspotIngest.App.Views.LegacyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importer dans Mediaspot (Legacy Importer)" Height="680" Width="1100" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="1. Contrôler : l'appli génère le XLSX, l'envoie sur Mediaspot et lance « Check assets » (rien n'est créé). 2. Importer : « Import assets » crée les requests, renomme chaque fichier avec son numéro et le transfère vers le stockage d'ingest ; l'appli récupère ensuite les numéros de request." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Voir le XLSX" Command="{Binding OpenXlsxCommand}" Margin="0,0,8,0" />
                <Button Content="1. Contrôler" Command="{Binding CheckCommand}" Margin="0,0,8,0" MinWidth="110" />
                <Button Content="2. Importer" Command="{Binding ImportCommand}" Margin="0,0,8,0" MinWidth="110" FontWeight="SemiBold" />
                <Button Content="Fermer" IsCancel="True" Click="Close_Click" MinWidth="90" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ProgressBar Height="6" Margin="0,6,16,0" Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Reports}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ligne" Binding="{Binding Report.Row}" Width="60" />
                <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="260" />
                <DataGridTextColumn Header="Résultat" Binding="{Binding Report.Tag}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MsError}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Message" Binding="{Binding Report.Message}" Width="*" MinWidth="260">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Valeurs possibles" Binding="{Binding Report.PossibleValues}" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
