<Window x:Class="MediaspotIngest.App.Views.ImportRegistryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau lot depuis le registre" Height="680" Width="820" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="Choisir l'export CSV du registre EuropaCorp, puis les titres à mettre dans le lot. Les éléments déjà présents dans un lot sont écartés." />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Choisir le fichier…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" />
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Description du lot" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox Content="Seulement les éléments à ingérer (décision mediaspot®, sinon recommandation « ingest »)"
                          IsChecked="{Binding OnlyToIngest}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="Tout cocher" Command="{Binding SelectAllCommand}" CommandParameter="True" Margin="0,0,6,0" />
                <Button Content="Tout décocher" Command="{Binding SelectAllCommand}" CommandParameter="False" />
            </StackPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="Créer le lot" IsDefault="True" Click="Create_Click" MinWidth="120" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Titles}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Titre" Binding="{Binding TitleName}" IsReadOnly="True" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="Dossier" Binding="{Binding TitleKey}" IsReadOnly="True" Width="220" />
                <DataGridTextColumn Header="Éléments" Binding="{Binding Count}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="Taille" Binding="{Binding Size}" IsReadOnly="True" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
