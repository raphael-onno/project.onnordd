<Window x:Class="MediaspotIngest.App.Views.TransferPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfert" Height="600" Width="1100" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Vérifier le plan avant de lancer : rien n'est écrasé, les lignes en « Problème » sont ignorées. « Contrôle fichier » (taille, sous-titres STL) est un avertissement : la ligne est transférée quand même, à vérifier." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="Lancer le transfert" IsDefault="True" Click="Run_Click" MinWidth="140" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding Steps}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fichier" Binding="{Binding Item.FileName}" Width="260" />
                <DataGridTextColumn Header="De" Binding="{Binding From}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="Vers" Binding="{Binding To}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="Contrôle fichier" Binding="{Binding Item.FileWarning}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B26A00" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Problème" Binding="{Binding Problem}" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#C93C37" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
