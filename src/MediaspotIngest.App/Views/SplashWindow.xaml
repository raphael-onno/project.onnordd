<Window x:Class="MediaspotIngest.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MediaspotIngest.App.Controls"
        Title="onnoRDD" Width="460" Height="280" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    <Border Background="{StaticResource MsPaper}" CornerRadius="12" BorderBrush="{StaticResource MsBorder}" BorderThickness="1" Padding="36,32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:LogoMark Width="72" Height="72" />
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="38" Foreground="{StaticResource MsText}">
                        <Run Text="onno" FontWeight="Normal" /><Run Text="RDD" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text="Ingest des archives dans Mediaspot" Foreground="{StaticResource MsTextSecondary}" FontSize="14" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="StatusText" Text="Chargement…" Foreground="{StaticResource MsTextTier}" FontSize="12" Margin="0,0,0,8" />
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource MsPrimary}" Background="{StaticResource MsNeutralAlpha}" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
