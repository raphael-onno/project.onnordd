<UserControl x:Class="MediaspotIngest.App.Views.BatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MediaspotIngest.App.Views">
    <UserControl.Resources>
        <!-- One step of the batch journey: what it is, where it stands, its one action. -->
        <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource MsPrimaryAlpha}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource MsText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,8,0,12" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: the batch -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                <Button Content="＋ Nouveau lot" Command="{Binding NewBatchFromRegistryCommand}" Style="{StaticResource SoftButton}" Margin="0,0,8,0" />
                <Button x:Name="MoreButton" Content="⋯" ToolTip="Autres actions" Padding="12,6" Click="MoreButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Relocaliser les fichiers" Command="{Binding LocateFilesCommand}" />
                            <MenuItem Header="Recalculer les métadonnées depuis le registre…" Command="{Binding RefillCommand}" />
                            <Separator />
                            <MenuItem Header="Récapitulatif de tous les lots (XLSX)" Command="{Binding ExportRecapCommand}" />
                            <MenuItem Header="Exporter le XLSX pour un import manuel…" Command="{Binding ExportCommand}" />
                            <MenuItem Header="Déplacer les fichiers acceptés vers done…" Command="{Binding MoveToDoneCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lot" FontSize="24" FontWeight="Medium" Foreground="{StaticResource MsText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" MinWidth="300" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       VerticalAlignment="Center" ToolTip="{Binding Status}" />
            <ProgressBar Grid.Column="1" Height="4" Value="{Binding Progress}" Foreground="{StaticResource MsPrimary}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Empty state -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="28" Margin="0,0,0,16"
                Visibility="{Binding HasBatch, Converter={x:Static views:Inverse.VisibilityInstance}}">
            <StackPanel>
                <TextBlock Text="Commencer un lot" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Hint}" FontSize="14" MaxWidth="720" HorizontalAlignment="Left"
                           Text="Un lot regroupe les éléments du registre qu'on ingère ensemble. Choisir l'export du registre et les titres : onnoRDD crée les fiches, pré-remplit les métadonnées et cherche les fichiers sur le Qumulo." />
                <Button Content="Nouveau lot depuis le registre" Command="{Binding NewBatchFromRegistryCommand}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- The journey: four steps, one action each -->
        <Grid DockPanel.Dock="Top" Margin="0,0,-12,16" IsEnabled="{Binding IsIdle}"
              Visibility="{Binding HasBatch, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Foreground="{StaticResource MsPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                        <TextBlock Text="Œuvres" Style="{StaticResource StepTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TitlesStepText}" Style="{StaticResource StepText}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Créer les œuvres" Command="{Binding CreateTitlesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Visibility="{Binding TitlesToCreate, Converter={StaticResource NullToCollapsed}}" />
                        <Button Content="Voir les titres" Command="{Binding OpenTitlesPageCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Foreground="{StaticResource MsPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                        <TextBlock Text="Fichiers" Style="{StaticResource StepTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FilesStepText}" Style="{StaticResource StepText}" />
                    <Button Content="Envoyer vers Mediaspot" Command="{Binding SendFilesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Visibility="{Binding FilesToSend, Converter={StaticResource NullToCollapsed}}"
                            ToolTip="Transfère les fichiers restaurés sur le Qumulo vers le dossier temp du provider (Aspera). Un plan est affiché avant." />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Foreground="{StaticResource MsPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                        <TextBlock Text="Import" Style="{StaticResource StepTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ImportStepText}" Style="{StaticResource StepText}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Importer dans Mediaspot" Command="{Binding ImportInMediaspotCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Visibility="{Binding ReadyToImport, Converter={StaticResource NullToCollapsed}}"
                                ToolTip="Legacy Importer : contrôle, puis création des requests et transfert vers le stockage d'ingest." />
                        <Button Content="Lignes à corriger" Command="{Binding ShowRowsToFixCommand}"
                                Visibility="{Binding RowsToFix, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" Foreground="{StaticResource MsPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                        <TextBlock Text="Suivi" Style="{StaticResource StepTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TrackingStepText}" Style="{StaticResource StepText}" />
                    <Button Content="Actualiser depuis Mediaspot" Command="{Binding TrackInMediaspotCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding InProgress, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rows and detail -->
        <Grid Visibility="{Binding HasBatch, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Background="{StaticResource MsSurface}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="130" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="Rechercher un titre ou un chemin" />
                        </StackPanel>
                        <TextBlock Text="Ctrl + clic pour limiter une action à certaines lignes." Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                              SelectionChanged="ItemsGrid_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" EnableRowVirtualization="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ouvrir dans Mediaspot" Command="{Binding OpenInMediaspotCommand}" />
                                <Separator />
                                <MenuItem Header="Retirer du lot" Command="{Binding RemoveFromBatchCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Statut" SortMemberPath="Status" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusFill}}" CornerRadius="6"
                                                Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding IssuesText}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       FontSize="12" FontWeight="Medium" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Titre" Binding="{Binding TitleKey}" Width="150" />
                            <DataGridTextColumn Header="Fichier" Binding="{Binding RelativePath}" Width="*" MinWidth="220" />
                            <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="90" />
                            <DataGridTextColumn Header="Fichier sur disque" Binding="{Binding Location}" Width="120" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="80" />
                            <DataGridTextColumn Header="Contrôle" Binding="{Binding FileWarning}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MsWarning}" />
                                        <Setter Property="ToolTip" Value="{Binding FileWarning}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Request" Binding="{Binding MediaspotAssetId}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Selected row: Legacy Importer cells -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedItem.FileName, TargetNullValue='Sélectionner une ligne'}" FontWeight="Medium" FontSize="15"
                                   Foreground="{StaticResource MsText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedItem.IssuesText}" Foreground="{StaticResource MsError}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding SelectedItem.IssuesText, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Colonnes du fichier d'import. ## = pas de valeur. Enregistré automatiquement." />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Cells}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="Cell" Background="{StaticResource MsPaper}" RowHeight="NaN">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Colonne" Width="170" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding TagName}" Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Text=" *" Foreground="{StaticResource MsError}"
                                                           Visibility="{Binding IsMandatory, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Layer}" FontSize="11" Foreground="{StaticResource MsTextTier}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Valeur" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <ComboBox ItemsSource="{Binding Options}" IsEditable="True" IsEnabled="{Binding IsReadOnly, Converter={x:Static views:Inverse.Instance}}"
                                                      Text="{Binding Value, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Stretch"
                                                      Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                     Visibility="{Binding HasOptions, Converter={x:Static views:Inverse.VisibilityInstance}}" />
                                            <TextBlock Text="{Binding Issue}" Foreground="{StaticResource MsError}" FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding Issue, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
