<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Mediaspot's dark theme (mediaspot.frontend, src/Theme/paletteDark.ts), applied over WPF's Fluent dark theme:
        the keys below replace Fluent's brushes of the same name.
    -->
    <Color x:Key="MsPrimaryColor">#2D6CE1</Color>

    <SolidColorBrush x:Key="MsPage" Color="#020203" />
    <SolidColorBrush x:Key="MsSurface" Color="#101018" />
    <SolidColorBrush x:Key="MsPaper" Color="#181824" />
    <SolidColorBrush x:Key="MsSurface200" Color="#202030" />
    <SolidColorBrush x:Key="MsSurface300" Color="#28283D" />
    <SolidColorBrush x:Key="MsPrimary" Color="#2D6CE1" />
    <SolidColorBrush x:Key="MsPrimaryHover" Color="#3773E2" />
    <SolidColorBrush x:Key="MsPrimaryText" Color="#4C8BFF" />
    <SolidColorBrush x:Key="MsPrimaryAlpha" Color="#262D6CE1" />
    <SolidColorBrush x:Key="MsText" Color="#EFEFEF" />
    <SolidColorBrush x:Key="MsTextSecondary" Color="#9999AD" />
    <SolidColorBrush x:Key="MsTextTier" Color="#7D7D96" />
    <SolidColorBrush x:Key="MsNeutralAlpha" Color="#0FC2C2D6" />
    <SolidColorBrush x:Key="MsNeutralHover" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="MsBorder" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="MsSuccess" Color="#1FC19A" />
    <SolidColorBrush x:Key="MsSuccessAlpha" Color="#401FC19A" />
    <SolidColorBrush x:Key="MsWarning" Color="#FCA464" />
    <SolidColorBrush x:Key="MsWarningAlpha" Color="#26FCA464" />
    <SolidColorBrush x:Key="MsError" Color="#ED6273" />
    <SolidColorBrush x:Key="MsErrorAlpha" Color="#26ED6273" />
    <SolidColorBrush x:Key="MsInfo" Color="#9C6CEA" />
    <SolidColorBrush x:Key="MsInfoAlpha" Color="#267E3FF5" />
    <SolidColorBrush x:Key="MsAccent" Color="#F7C035" />

    <!-- Fluent overrides -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#101018" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#101018" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#020203" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#181824" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#202030" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#28283D" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#181824" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#141420" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#181824" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FC2C2D6" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1AC2C2D6" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14C2C2D6" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2D6CE1" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3773E2" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2B67D6" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#2D6CE1" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4C8BFF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#4C8BFF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#3773E2" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9999AD" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7D7D96" />

    <!-- Selected rows: Fluent paints them light grey with black text; Mediaspot uses a dark primary tint. -->
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#1F2D52" />
    <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#1F2D52" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#263763" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="#1F2D52" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#1F2D52" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#EFEFEF" />

    <FontFamily x:Key="MsFont">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Buttons: Mediaspot's soft neutral by default, solid blue for the one main action -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource MsPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource MsPrimaryAlpha}" />
        <Setter Property="Foreground" Value="{StaticResource MsPrimaryText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- Sidebar navigation: selected item is solid primary, like Mediaspot's sidebar -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MsTextTier}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MsNeutralAlpha}" />
                            <Setter Property="Foreground" Value="{StaticResource MsText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MsPrimary}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MsPrimaryText}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A raised panel (Mediaspot "paper") -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MsPaper}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{StaticResource MsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource MsText}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource MsTextTier}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MsTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Data grids: no outer frame, divider rows, tier-coloured headers, primary-tinted selection -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource MsSurface}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MsBorder}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="36" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Foreground" Value="{StaticResource MsTextTier}" />
        <Setter Property="Background" Value="{StaticResource MsSurface}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Foreground" Value="{StaticResource MsText}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1F2D52" />
                <Setter Property="Foreground" Value="{StaticResource MsText}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MsNeutralAlpha}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Foreground" Value="{StaticResource MsText}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1F2D52" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MsText}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
