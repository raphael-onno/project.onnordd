<Window x:Class="MediaspotIngest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MediaspotIngest.App.Views"
        xmlns:controls="clr-namespace:MediaspotIngest.App.Controls"
        Title="onnoRDD" Icon="Assets/onnoRDD.ico" Height="880" Width="1480" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource MsPage}" FontFamily="{StaticResource MsFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar, as in Mediaspot -->
        <Border Background="{StaticResource MsSurface}" BorderBrush="{StaticResource MsBorder}" BorderThickness="0,0,1,0" Padding="14,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,26">
                    <controls:LogoMark Width="30" Height="30" />
                    <TextBlock FontSize="21" Foreground="{StaticResource MsText}" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="onno" /><Run Text="RDD" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>

                <!-- Platform and connection -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="PLATEFORME" Style="{StaticResource Overline}" Margin="4,0,0,6" />
                    <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Hint}" Margin="4,10,0,6" />
                    <Button Content="Se connecter à Mediaspot" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Overline}" Margin="4,14,0,0" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding ShowBatches}">
                        <StackPanel>
                            <TextBlock Text="Lots" FontWeight="Medium" />
                            <TextBlock Text="Préparer, envoyer, importer" FontSize="11.5" Opacity="0.75" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding ShowTitles}">
                        <StackPanel>
                            <TextBlock Text="Titres" FontWeight="Medium" />
                            <TextBlock Text="Fiches œuvre dans Mediaspot" FontSize="11.5" Opacity="0.75" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding ShowConfiguration}">
                        <StackPanel>
                            <TextBlock Text="Configuration" FontWeight="Medium" />
                            <TextBlock Text="Plateformes, stockages, comptes" FontSize="11.5" Opacity="0.75" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages (kept alive: switching does not lose the selection) -->
        <Grid Grid.Column="1" Margin="20,18,20,16">
            <views:BatchesView DataContext="{Binding Batches}" Visibility="{Binding DataContext.ShowBatches, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <views:TitlesView DataContext="{Binding Titles}" Visibility="{Binding DataContext.ShowTitles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <views:ConfigurationView DataContext="{Binding Configuration}" Visibility="{Binding DataContext.ShowConfiguration, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
